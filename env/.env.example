# 이 파일은 env/.env 로 복사해서 사용하세요 (env/ 폴더 전체를 직접 접근 불가능하도록 권한을 잠그는 것을 권장합니다).
#
# 폴더 위치 자체를 바꾸고 싶다면(예: 리포지토리 밖의 별도 볼륨), 이 .env 파일이 아니라
# 서버를 실행하는 셸/서비스 유닛에서 ENV_DIR 환경변수를 지정하세요. (닭-달걀 문제: 이 값은
# .env 를 찾기 "전에" 필요하므로 .env 안에 넣어도 적용되지 않습니다.)
#   ENV_DIR=/absolute/path/to/env node dist/index.js

# Server
PORT=3000
NODE_ENV=development
# httpOnly 세션 쿠키(JWT) 서명 키. openssl rand -hex 32 등으로 생성한 무작위 값을 사용하세요.
SESSION_SECRET=change_me_to_a_random_64_char_hex_string
SESSION_TTL_HOURS=12

ANTHROPIC_VERSION=2023-06-01

# 이메일-그룹 매핑 파일 경로. 기본값은 이 .env와 같은 env/ 폴더 안의 group_master.env 이며, 필요할 때만 지정하세요.
# GROUP_MASTER_PATH=/absolute/path/to/group_master.env

# [개발/테스트 전용 모드]
# 현재는 Admin API 키를 .env에 넣지 않습니다. 화면의 "Admin API 키" 입력창에 매번 직접 입력하면,
# 그 값이 요청 헤더로만 전달되고 서버에는 저장되지 않습니다.
# 운영 전환 시에는 아래 두 줄의 주석을 해제하고, 코드도 함께 되돌려야 합니다
# (src/config.ts, src/middleware/adminKey.ts, src/services/anthropicAdmin.ts 상단 주석 참고).
# CLAUDE_ADMIN_API_KEY=sk-ant-admin-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# read:spend_limits, write:spend_limits 스코프가 반드시 필요합니다.

# OTP(6자리 인증코드)
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30

# 그룹 평균 토큰 제한 초과 알림
# 개인별 제한을 저장하는 시점에, 그 그룹 구성원들의 평균 토큰 제한이 아래 금액(USD)을 초과하면
# 화면에 확인창이 뜹니다. "예"를 누르고 진행하면 아래 관리자들에게 그 그룹의 토큰 현황을 알립니다.
# (현재 개발/테스트 모드에서는 실제 메일 발송 대신 화면 알림창으로 대체됩니다 - src/routes/members.ts 참고.)
GROUP_AVG_LIMIT_ALERT_THRESHOLD_USD=100
# 콤마(,)로 구분해서 2명 이상 등록할 수 있습니다.
ADMIN_NOTIFY_EMAILS=admin1@lgacademy.com,admin2@lgacademy.com

# [개발/테스트 전용 모드] 이메일 발송을 사용하지 않으므로 SMTP 설정은 필요 없습니다 (없어도 서버가 정상 기동됩니다).
# 운영 전환 시 아래 값을 채우고 src/routes/auth.ts 의 sendOtpEmail 호출 주석을 해제하세요.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=noreply@example.com
# SMTP_PASS=change_me
# SMTP_FROM="Claude Token Manager <noreply@example.com>"
