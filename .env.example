# Server
PORT=3000
NODE_ENV=production
# httpOnly 세션 쿠키(JWT) 서명 키. openssl rand -hex 32 등으로 생성한 무작위 값을 사용하세요.
SESSION_SECRET=change_me_to_a_random_64_char_hex_string
SESSION_TTL_HOURS=12

# Claude Enterprise Admin API
# Claude Console(claude.ai Organization settings)에서 발급한 Admin API key.
# read:spend_limits, write:spend_limits 스코프가 반드시 필요합니다.
CLAUDE_ADMIN_API_KEY=sk-ant-admin-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_VERSION=2023-06-01

# OTP(6자리 인증코드)
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30

# SMTP (인증코드 발송용 메일 서버)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@example.com
SMTP_PASS=change_me
SMTP_FROM="Claude Token Manager <noreply@example.com>"
